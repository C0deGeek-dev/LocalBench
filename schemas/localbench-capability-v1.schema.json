{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localbench.local/schemas/localbench-capability-v1.schema.json",
  "title": "LocalBench harness capability comparative report (v1)",
  "description": "Comparative harness-capability report across arms, emitted by `localbench arms` (the CapabilityReport wire format). LocalPilot owns the harness and the per-task capability scorecard; LocalBench drives the solver per task (against an external public corpus materialized outside the LocalPilot clean-room tree), grades in a container, and persists the comparison. Public-benchmark numbers are contamination-suspect: read them as deltas between arms, never as trusted absolutes.",
  "type": "object",
  "required": ["schema", "corpus", "contamination_suspect", "arms"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "corpus": { "enum": ["first-party", "external"] },
    "contamination_suspect": { "type": "boolean" },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "arm",
          "model",
          "tasks",
          "solved",
          "solve_rate",
          "avg_tool_calls",
          "avg_redundant",
          "avg_diff_added",
          "avg_interventions",
          "judge_overall",
          "isolation"
        ],
        "properties": {
          "arm": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "tasks": { "type": "integer", "minimum": 0 },
          "solved": { "type": "integer", "minimum": 0 },
          "solve_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "avg_tool_calls": { "type": "number", "minimum": 0 },
          "avg_redundant": { "type": "number", "minimum": 0 },
          "avg_diff_added": { "type": "number", "minimum": 0 },
          "avg_interventions": { "type": "number", "minimum": 0 },
          "judge_overall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "isolation": { "type": ["string", "null"] }
        }
      }
    }
  }
}
