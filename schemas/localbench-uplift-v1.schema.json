{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localbench.local/schemas/localbench-uplift-v1.schema.json",
  "title": "LocalBench lesson-uplift report (v1)",
  "description": "A multi-trial lesson-on/off uplift A/B over a headroom task set, emitted by `localbench uplift` (the UpliftReport wire format). Each arm reports per-trial success rates aggregated to mean/stddev, plus the memories-used injection summary that makes the result void if the arm did not inject as configured. The uplift block reports the delta against the pooled-stddev band as a verdict (uplift / no-effect / regression), never a bare number. Live local-model numbers are opportunistic per the validation-evidence policy.",
  "type": "object",
  "required": ["schema", "task_set", "model", "trials", "arms", "uplift"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "task_set": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "trials": { "type": "integer", "minimum": 1 },
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "arm",
          "is_lesson_arm",
          "trials",
          "task_count",
          "per_trial_success_rate",
          "mean",
          "stddev",
          "injection"
        ],
        "properties": {
          "arm": { "type": "string", "minLength": 1 },
          "is_lesson_arm": { "type": "boolean" },
          "trials": { "type": "integer", "minimum": 1 },
          "task_count": { "type": "integer", "minimum": 1 },
          "per_trial_success_rate": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "mean": { "type": "number", "minimum": 0, "maximum": 1 },
          "stddev": { "type": "number", "minimum": 0 },
          "injection": {
            "type": "object",
            "required": ["arm", "is_lesson_arm", "intended", "injected"],
            "properties": {
              "arm": { "type": "string", "minLength": 1 },
              "is_lesson_arm": { "type": "boolean" },
              "intended": { "type": "array", "items": { "type": "string" } },
              "injected": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "uplift": {
      "type": "object",
      "required": [
        "baseline_arm",
        "lesson_arm",
        "baseline_mean",
        "lesson_mean",
        "delta",
        "pooled_std_dev",
        "band",
        "effect_size",
        "verdict"
      ],
      "properties": {
        "baseline_arm": { "type": "string", "minLength": 1 },
        "lesson_arm": { "type": "string", "minLength": 1 },
        "baseline_mean": { "type": "number", "minimum": 0, "maximum": 1 },
        "lesson_mean": { "type": "number", "minimum": 0, "maximum": 1 },
        "delta": { "type": "number" },
        "pooled_std_dev": { "type": "number", "minimum": 0 },
        "band": { "type": "number", "minimum": 0 },
        "effect_size": { "type": ["number", "null"] },
        "verdict": { "enum": ["uplift", "no-effect", "regression"] }
      }
    }
  }
}
